# Copy this file to .env and fill in real values for local development.

# MySQL connection string. Update the user/password/host/port/database name
# to match your local MySQL instance. connection_limit/pool_timeout tune the
# Prisma connection pool (defaults would otherwise be num_cpus*2+1 / 10s).
DATABASE_URL="mysql://root:your_password@localhost:3306/reg_pay?connection_limit=10&pool_timeout=20"

PORT=5000

# Comma-separated list of allowed frontend origins for CORS. Optional -
# defaults to localhost:3000/3001/5000 (see src/main.ts) if unset.
# CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Use long, random values in any real deployment.
JWT_ACCESS_SECRET="replace_with_a_long_random_secret"
JWT_REFRESH_SECRET="replace_with_a_different_long_random_secret"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Used only by `npm run seed:super-admin` to seed the first super admin
# account. Optional - the seed script falls back to defaults if unset.
SEED_SUPER_ADMIN_EMAIL=admin@reg.rw
SEED_SUPER_ADMIN_PHONE=+250788000000
SEED_SUPER_ADMIN_PASSWORD=Admin@RegPay2024!

# Base URL of the frontend app, used to build links inside emails
# (e.g. the password reset link). Defaults to http://localhost:3000 if unset.
FRONTEND_URL=http://localhost:3000

# SMTP credentials used to send account setup, password-reset, and
# account-verification-code emails. If unset, emails are logged instead of
# sent - fine for local dev, but account setup and verification messages will
# not actually deliver.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="REG Pay <no-reply@regpay.local>"

# Cloudinary credentials used to store user/employee profile pictures.
# Required for avatar upload endpoints to work - without them, uploads
# fail with a clear error instead of writing to local disk.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
